{
  "interfaceVersion": "3.0.0",
  "purpose": "Trusted retrieval provenance bound to the same adapter-supplied canonical resource, principal, and source scopes as authorization. Azure Resource Graph returns one context per requested subscription or management group. Purview retrieval-job creation may include a trusted retrieval_job_preconditions record bound to the canonical request digest.",
  "approvedProvider": {
    "provider_id": "havoc-provenance-context-provider",
    "minimum_provider_version": "3.0.0"
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operationId", "requestId", "correlationId",
      "canonical_resource_string", "expected_principal_ref",
      "expected_source_scope_refs"
    ],
    "properties": {
      "expected_source_scope_refs": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/protectedContextRef" },
        "description": "For Azure Resource Graph, one adapter-derived protected ref per body.subscriptions[] and body.managementGroups[] entry; provider contexts must match this exact set."
      }
    }
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["contexts", "provider_id", "provider_version"],
    "properties": {
      "contexts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id", "resource_binding_hmac",
            "resource_identifier_ref", "principal_ref", "source_scope_ref",
            "workspace_context_ref", "source_context_ref", "connector_ref",
            "dcr_transformation_ref", "automation_actor_source_ref",
            "source_locale", "raw_identifier_ref", "schema_version",
            "source_version", "historical_detection_version_ref",
            "historical_detection_effective_at", "evidence_refs",
            "sentinel_onboarded", "workspace_covered", "connector_healthy"
          ],
          "properties": {
            "operation_id": {
              "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"
            },
            "resource_binding_hmac": {
              "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "resource_identifier_ref": { "$ref": "#/$defs/protectedContextRef" },
            "principal_ref": { "$ref": "#/$defs/protectedContextRef" },
            "source_scope_ref": { "$ref": "#/$defs/protectedContextRef" },
            "retrieval_job_preconditions": {
              "$ref": "#/$defs/retrievalJobPreconditions",
              "description": "Only valid for purview-audit-query-create; callers must not supply this in RequestIntent."
            }
          }
        }
      },
      "provider_id": { "const": "havoc-provenance-context-provider" },
      "provider_version": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
        "description": "Stable semantic version greater than or equal to 3.0.0."
      }
    }
  },
  "$defs": {
    "protectedContextRef": {
      "type": "string",
      "pattern": "^protected-context:[a-z0-9][a-z0-9._/-]*$"
    },
    "protectedEvidenceRef": {
      "type": "string",
      "pattern": "^protected-evidence:[a-z0-9][a-z0-9._/-]*$"
    },
    "retrievalJobPreconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_request_digest", "request_digest_hmac", "evidence_ref",
        "operational_necessity_verified", "lifecycle_verified",
        "persistence_verified", "visibility_sharing_verified",
        "retention_expiry_verified", "side_effects_verified",
        "least_privilege_verified", "bounded_request_verified",
        "commercial_endpoint_verified", "report_disclosure_planned"
      ],
      "properties": {
        "canonical_request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_digest_hmac": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "description": "HMAC-SHA256 over canonical_request_digest using the trusted capability binding root."
        },
        "evidence_ref": { "$ref": "#/$defs/protectedEvidenceRef" },
        "operational_necessity_verified": { "type": "boolean", "const": true },
        "lifecycle_verified": { "type": "boolean", "const": true },
        "persistence_verified": { "type": "boolean", "const": true },
        "visibility_sharing_verified": { "type": "boolean", "const": true },
        "retention_expiry_verified": { "type": "boolean", "const": true },
        "side_effects_verified": { "type": "boolean", "const": true },
        "least_privilege_verified": { "type": "boolean", "const": true },
        "bounded_request_verified": { "type": "boolean", "const": true },
        "commercial_endpoint_verified": { "type": "boolean", "const": true },
        "report_disclosure_planned": { "type": "boolean", "const": true }
      }
    }
  }
}
