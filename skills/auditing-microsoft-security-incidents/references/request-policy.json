{
  "schemaVersion": "1.0",
  "policyVersion": "2026-09-28.1",
  "cloud": "commercial",
  "canonicalHosts": [
    "api.loganalytics.azure.com",
    "api.security.microsoft.com",
    "graph.microsoft.com",
    "management.azure.com"
  ],
  "redirectPolicy": "manual-reauthorization-required;automatic-follow-disabled;cross-origin-authorization-forwarding-disabled",
  "globalBounds": {
    "maxTimeRangeDays": 31,
    "maxRows": 10000,
    "maxBytes": 10485760,
    "maxRuntimeSeconds": 300,
    "maxWorkspaces": 1,
    "maxSubscriptions": 20,
    "maxBatchRequests": 20
  },
  "allowedTimespanFormats": [
    "start/end"
  ],
  "crossResourceFunctions": [
    "adx",
    "app",
    "arg",
    "cluster",
    "database",
    "externaldata",
    "resource",
    "workspace"
  ],
  "responseAdapterCapabilities": [
    {
      "adapterId": "havoc-protected-store-adapter",
      "adapterVersion": "1.0.0"
    }
  ],
  "capabilityTrust": {
    "maxLifetimeSeconds": 300,
    "maxClockSkewSeconds": 30,
    "issuers": [
      {
        "issuerId": "havoc-adapter-orchestrator",
        "issuerVersion": "1.0.0",
        "keyId": "havoc-capability-hmac-v1"
      }
    ]
  },
  "knownMutationPathPatterns": [
    "^.*(?:/comments?|/sendmail|/revokesigninsessions|/members/\\$ref|/tiindicators|/retire|/wipe|/isolate|/unisolate|/release|/quarantine|/purge|/remediate|/resetpassword|/sharedkeys|/listkeys)(?:/|$|\\?).*$",
    "^.*/informationprotection/threatassessmentrequests(?:/|$|\\?).*$",
    "^.*/security/incidents/[^/]+/(?:update|comments?)(?:/|$|\\?).*$"
  ],
  "conditionalCapabilities": {
    "graphSecurityHunting": {
      "enabled": false,
      "reason": "preview_policy_profile_required"
    },
    "defenderLegacyHunting": {
      "enabled": false,
      "reason": "compatibility_disabled"
    }
  },
  "odata": {
    "builderRequired": true,
    "allowedFields": {
      "status": [
        "string"
      ],
      "severity": [
        "string"
      ],
      "assignedTo": [
        "string"
      ],
      "createdDateTime": [
        "datetime"
      ],
      "activityDateTime": [
        "datetime"
      ],
      "detectedDateTime": [
        "datetime"
      ],
      "userId": [
        "string"
      ],
      "appId": [
        "string"
      ],
      "ipAddress": [
        "string"
      ],
      "riskState": [
        "string"
      ],
      "riskLevel": [
        "string"
      ]
    },
    "allowedOperators": [
      "eq",
      "ne",
      "ge",
      "gt",
      "le",
      "lt"
    ],
    "maxLiteralLength": 128
  },
