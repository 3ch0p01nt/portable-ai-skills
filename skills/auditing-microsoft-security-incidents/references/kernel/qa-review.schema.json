{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-review.schema.json",
  "title": "HAVOC investigation quality assurance review record",
  "type": "object",
  "required": [
    "qa_id",
    "rubric_id",
    "rubric_version",
    "reviewer_role",
    "reviewer_id",
    "independence_basis",
    "audit_author_id",
    "review_context_id",
    "reviewer_verdict",
    "adjudication_state",
    "checks",
    "limitations",
    "claim_ids",
    "evidence_ids",
    "gap_ids",
    "error_ids",
    "behavior_bases",
    "sealed_verdict",
    "reveal",
    "comparison",
    "disagreements",
    "adjudication_request",
    "calibration_metrics"
  ],
  "properties": {
    "qa_id": { "$ref": "#/$defs/identifier" },
    "rubric_id": { "type": "string", "minLength": 1 },
    "rubric_version": { "$ref": "#/$defs/semanticVersion" },
    "reviewer_role": { "type": "string", "enum": ["independent_quality_reviewer", "adjudicator", "calibration_reviewer"] },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "independence_basis": { "type": "string", "minLength": 1 },
    "audit_author_id": { "type": "string", "minLength": 1 },
    "review_context_id": { "type": "string", "minLength": 1 },
    "reviewer_verdict": { "type": "string", "enum": ["pass", "pass_with_limitations", "fail", "not_independent"] },
    "adjudication_state": { "type": "string", "enum": ["not_required", "pending", "agreed", "resolved", "unresolved"] },
    "checks": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$" },
      "additionalProperties": { "type": "boolean" }
    },
    "limitations": { "$ref": "#/$defs/stringArray" },
    "claim_ids": { "$ref": "#/$defs/idArray" },
    "evidence_ids": { "$ref": "#/$defs/idArray" },
    "gap_ids": { "$ref": "#/$defs/idArray" },
    "error_ids": { "$ref": "#/$defs/idArray" },
    "behavior_bases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["guaranteed_behavior", "configurable_project_policy", "conditional_capability", "explicit_gap"] }
    },
    "sealed_verdict": { "$ref": "#/$defs/sealedVerdict" },
    "reveal": { "$ref": "#/$defs/revealRecord" },
    "comparison": { "$ref": "#/$defs/comparisonRecord" },
    "disagreements": { "type": "array", "items": { "$ref": "#/$defs/disagreementRecord" } },
    "adjudication_request": { "$ref": "#/$defs/adjudicationRequest" },
    "calibration_metrics": { "$ref": "#/$defs/calibrationMetrics" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
    "semanticVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reviewFields": {
      "type": "object",
      "required": ["disposition", "severity_band", "causal_edges", "soc_quality", "recovery_validity"],
      "properties": {
        "disposition": { "type": "string", "enum": ["malicious_true_positive", "benign_true_positive", "rule_logic_false_positive", "incorrect_data_false_positive", "inconclusive"] },
        "severity_band": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
        "causal_edges": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "soc_quality": { "type": "string", "enum": ["reasonable_with_available_evidence", "questionable_with_available_evidence", "not_assessable", "outcome_only_hindsight"] },
        "recovery_validity": { "type": "string", "enum": ["validated", "not_validated", "partially_validated", "not_assessable"] }
      },
      "additionalProperties": false
    },
    "sealedVerdict": {
      "type": "object",
      "required": ["sealed_at", "digest_algorithm", "canonicalization", "digest", "content"],
      "properties": {
        "sealed_at": { "$ref": "#/$defs/dateTime" },
        "digest_algorithm": { "type": "string", "const": "SHA-256" },
        "canonicalization": { "type": "string", "const": "canonical-json-sort-properties-v1" },
        "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "content": { "$ref": "#/$defs/reviewFields" }
      },
      "additionalProperties": false
    },
    "revealRecord": {
      "type": "object",
      "required": ["revealed_at", "revealed_to"],
      "properties": {
        "revealed_at": { "$ref": "#/$defs/dateTime" },
        "revealed_to": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "comparisonRecord": {
      "type": "object",
      "required": ["compared_at", "rubric_version_original", "original_audit", "reviewer_verdict"],
      "properties": {
        "compared_at": { "$ref": "#/$defs/dateTime" },
        "rubric_version_original": { "$ref": "#/$defs/semanticVersion" },
        "original_audit": { "$ref": "#/$defs/reviewFields" },
        "reviewer_verdict": { "$ref": "#/$defs/reviewFields" }
      },
      "additionalProperties": false
    },
    "disagreementRecord": {
      "type": "object",
      "required": ["field", "classification", "material", "reason"],
      "properties": {
        "field": { "type": "string", "enum": ["disposition", "severity_band", "root_cause_edges", "soc_quality", "recovery_validity", "rubric_version"] },
        "classification": { "type": "string", "enum": ["material", "minor"] },
        "material": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "adjudicationRequest": {
      "type": "object",
      "required": ["required", "requested_at", "route", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "requested_at": { "$ref": "#/$defs/dateTime" },
        "route": { "type": "string", "enum": ["human_adjudicator"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "calibrationMetrics": {
      "type": "object",
      "required": ["metric_scope", "percent_agreement", "cohens_kappa"],
      "properties": {
        "metric_scope": { "type": "string", "minLength": 1 },
        "percent_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
        "cohens_kappa": { "type": "number", "minimum": -1, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
