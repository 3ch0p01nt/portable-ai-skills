{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internationalized-identifier.schema.json",
  "title": "Internationalized Identifier and Normalization Record",
  "description": "Closed kernel record for preserving protected references and digests for internationalized identifiers beside deterministic risk findings.",
  "type": "object",
  "required": [
    "record_id",
    "raw_value_ref",
    "raw_value_sha256",
    "identifier_kind",
    "locale_used",
    "normalized",
    "nfkc_changed",
    "detected_scripts",
    "mixed_script",
    "bidi_controls_present",
    "bidi_controls",
    "zero_width_chars_present",
    "zero_width_chars",
    "confusable_skeleton_sha256",
    "confusable_skeleton_changed",
    "confusable_map_version",
    "homograph_risk",
    "extension_spoofing_detected",
    "normalized_comparison_key_sha256",
    "unicode_risks",
    "limitations",
    "behavior_bases"
  ],
  "properties": {
    "record_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
    "raw_value_ref": {
      "type": "string",
      "pattern": "^protected-evidence:i18n/raw/[a-f0-9]{24}$",
      "description": "Opaque protected evidence-store reference for the raw identifier. The record does not expose raw tenant or user identifiers."
    },
    "raw_value_sha256": { "$ref": "#/$defs/sha256" },
    "identifier_kind": { "type": "string", "enum": ["domain", "filename", "account", "url", "text", "other"] },
    "locale_used": { "type": "string", "minLength": 2 },
    "normalized": {
      "type": "object",
      "required": [
        "nfc_sha256",
        "nfkc_sha256",
        "invariant_case_fold_sha256",
        "culture_case_fold_sha256",
        "culture_case_fold_differs",
        "idn_conversion_state"
      ],
      "properties": {
        "nfc_sha256": { "$ref": "#/$defs/sha256" },
        "nfkc_sha256": { "$ref": "#/$defs/sha256" },
        "invariant_case_fold_sha256": { "$ref": "#/$defs/sha256" },
        "culture_case_fold_sha256": { "$ref": "#/$defs/sha256" },
        "culture_case_fold_differs": { "type": "boolean" },
        "idn_conversion_state": { "type": "string", "enum": ["not_applicable", "converted", "conversion_failed"] },
        "idn_alabel_sha256": { "$ref": "#/$defs/sha256" },
        "idn_ulabel_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "idn_conversion_state": { "const": "converted" } }, "required": ["idn_conversion_state"] },
          "then": { "required": ["idn_alabel_sha256", "idn_ulabel_sha256"] }
        },
        {
          "if": { "properties": { "idn_conversion_state": { "const": "conversion_failed" } }, "required": ["idn_conversion_state"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["idn_alabel_sha256"] },
                { "required": ["idn_ulabel_sha256"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "nfkc_changed": { "type": "boolean" },
    "detected_scripts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["Latin", "Cyrillic", "Greek", "Other"] }
    },
    "mixed_script": { "type": "boolean" },
    "bidi_controls_present": { "type": "boolean" },
    "bidi_controls": { "type": "array", "items": { "$ref": "#/$defs/codePointFinding" } },
    "zero_width_chars_present": { "type": "boolean" },
    "zero_width_chars": { "type": "array", "items": { "$ref": "#/$defs/codePointFinding" } },
    "confusable_skeleton_sha256": { "$ref": "#/$defs/sha256" },
    "confusable_skeleton_changed": { "type": "boolean" },
    "confusable_map_version": { "type": "string", "const": "curated-2026-09-25" },
    "homograph_risk": { "type": "boolean" },
    "extension_spoofing_detected": { "type": "boolean" },
    "normalized_comparison_key_sha256": { "$ref": "#/$defs/sha256" },
    "unicode_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "mixed-script",
          "confusable-skeleton",
          "compatibility-lookalike",
          "bidi-control",
          "invisible-control",
          "idn-conversion-failed"
        ]
      }
    },
    "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "behavior_bases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["guaranteed_behavior", "configurable_project_policy", "conditional_capability", "explicit_gap"] }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "identifier_kind": { "const": "domain" } }, "required": ["identifier_kind"] },
      "then": { "properties": { "normalized": { "properties": { "idn_conversion_state": { "enum": ["converted", "conversion_failed"] } } } } }
    },
    {
      "if": { "properties": { "mixed_script": { "const": true } }, "required": ["mixed_script"] },
      "then": { "properties": { "homograph_risk": { "const": true } } }
    },
    {
      "if": { "properties": { "nfkc_changed": { "const": true } }, "required": ["nfkc_changed"] },
      "then": {
        "properties": {
          "homograph_risk": { "const": true },
          "unicode_risks": { "contains": { "const": "compatibility-lookalike" } }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "codePointFinding": {
      "type": "object",
      "required": ["code_point", "escaped", "name", "index"],
      "properties": {
        "code_point": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" },
        "escaped": { "type": "string", "pattern": "^\\\\u[0-9A-F]{4}$" },
        "name": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
