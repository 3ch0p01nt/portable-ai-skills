{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-ledger.schema.json",
  "title": "HAVOC kernel query ledger entry",
  "description": "Closed Task 6 kernel schema for query/API ledger records. Compatible with audit-output queryRecord.",
  "allOf": [
    { "$ref": "../audit-output.schema.json#/$defs/queryRecord" },
    {
      "type": "object",
      "required": [
        "operation_id",
        "source_id",
        "target",
        "canonical_request_ref",
        "time_bounds",
        "entity_bounds",
        "scope_bounds",
        "result_bounds",
        "adapter_version",
        "started_at",
        "ended_at",
        "authorized_purpose",
        "response_classification",
        "pagination_state",
        "continuation_state",
        "result_count",
        "truncation_state",
        "partial_state",
        "throttling_state",
        "retry_state",
        "status_or_error_ref",
        "protected_payload_ref",
        "claim_ids",
        "evidence_ids",
        "gap_ids",
        "error_ids",
        "behavior_bases",
        "effective_window",
        "equivalent_query_fingerprint",
        "request_reference_class",
        "query_reference_class",
        "repeat_detection_scope",
        "adapter_envelope_status",
        "coverage_contribution_id"
      ],
      "properties": {
        "request_id": { "$ref": "../audit-output.schema.json#/$defs/identifier" },
        "operation_id": { "$ref": "../audit-output.schema.json#/$defs/identifier" },
        "source_id": { "$ref": "../audit-output.schema.json#/$defs/identifier" },
        "target": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(?i)(DeviceNetworkEvents|skip-token|token=|authorization|bearer)" }
        },
        "canonical_request_ref": { "$ref": "../audit-output.schema.json#/$defs/canonicalRequestReference" },
        "time_bounds": { "$ref": "../audit-output.schema.json#/$defs/boundedWindow" },
        "entity_bounds": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(?i)(00000000-0000-4000-8000-000000000001|DeviceNetworkEvents|skip-token|authorization|bearer)" }
        },
        "scope_bounds": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(?i)(/subscriptions/|authorization|bearer)" }
        },
        "result_bounds": { "type": "string", "minLength": 1 },
        "runtime_bounds": { "type": "string", "minLength": 1 },
        "adapter_version": { "$ref": "../contract-vocabulary.json#/$defs/semanticVersion" },
        "started_at": { "$ref": "../audit-output.schema.json#/$defs/timestamp" },
        "ended_at": { "$ref": "../audit-output.schema.json#/$defs/timestamp" },
        "retrieval_at": { "$ref": "../audit-output.schema.json#/$defs/timestamp" },
        "authorized_purpose": { "type": "string", "minLength": 1 },
        "response_classification": { "$ref": "../contract-vocabulary.json#/$defs/queryResponseClassification" },
        "pagination_state": { "$ref": "../audit-output.schema.json#/$defs/explicitState" },
        "continuation_state": { "$ref": "../audit-output.schema.json#/$defs/explicitState" },
        "result_count": { "type": "integer", "minimum": 0 },
        "row_count": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "correlation_ids": { "$ref": "../audit-output.schema.json#/$defs/stringArray" },
        "status": { "type": "string", "enum": ["success", "partial", "failed", "denied", "unsupported"] },
        "error_ref": { "type": "string", "minLength": 1 },
        "truncation_state": { "$ref": "../audit-output.schema.json#/$defs/explicitState" },
        "partial_state": { "$ref": "../audit-output.schema.json#/$defs/explicitState" },
        "throttling_state": { "$ref": "../audit-output.schema.json#/$defs/explicitState" },
        "retry_state": { "$ref": "../audit-output.schema.json#/$defs/explicitState" },
        "status_or_error_ref": { "type": "string", "minLength": 1 },
        "protected_payload_ref": { "$ref": "../audit-output.schema.json#/$defs/protectedReference" },
        "claim_ids": { "$ref": "../audit-output.schema.json#/$defs/idArray" },
        "evidence_ids": { "$ref": "../audit-output.schema.json#/$defs/idArray" },
        "gap_ids": { "$ref": "../audit-output.schema.json#/$defs/idArray" },
        "error_ids": { "$ref": "../audit-output.schema.json#/$defs/idArray" },
        "behavior_bases": { "$ref": "../audit-output.schema.json#/$defs/behaviorBases" },
        "effective_window": { "$ref": "../audit-output.schema.json#/$defs/boundedWindow" },
        "equivalent_query_fingerprint": { "type": "string", "pattern": "^eqf-v1:[a-f0-9]{64}$" },
        "request_reference_class": { "type": "string", "const": "protected-request" },
        "query_reference_class": { "type": "string", "const": "protected-request" },
        "repeat_detection_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(protected-context|protected-evidence|unknown|not-applicable):[a-z0-9][a-z0-9._/-]*$" }
        },
        "adapter_envelope_status": { "type": "string", "enum": ["success", "partial", "failed", "denied", "unsupported"] },
        "coverage_contribution_id": { "$ref": "../audit-output.schema.json#/$defs/identifier" }
      },
      "additionalProperties": false
    }
  ]
}
