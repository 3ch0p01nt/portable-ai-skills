{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "HAVOC evidence provenance and confidence kernel",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/evidenceItem" },
    { "$ref": "#/$defs/claimCitation" },
    { "$ref": "#/$defs/sourceConfidence" },
    { "$ref": "#/$defs/sourceLineage" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "behaviorBasis": {
      "type": "string",
      "enum": [
        "guaranteed_behavior",
        "configurable_project_policy",
        "conditional_capability",
        "explicit_gap"
      ]
    },
    "behaviorBases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/behaviorBasis" }
    },
    "likelihood": {
      "type": "string",
      "enum": [
        "highly_unlikely",
        "unlikely",
        "roughly_even",
        "likely",
        "highly_likely",
        "not_assessed"
      ]
    },
    "analyticConfidence": {
      "type": "string",
      "enum": ["low", "moderate", "high", "not_assessed"]
    },
    "evidenceClass": {
      "type": "string",
      "enum": ["fact", "inference", "assumption", "recommendation"]
    },
    "evidenceRole": {
      "type": "string",
      "enum": [
        "observed_fact",
        "analytic_inference",
        "coverage_gap",
        "threat_intelligence_lead",
        "recommendation"
      ]
    },
    "supportDirection": {
      "type": "string",
      "enum": ["supporting", "contradicting", "context", "gap"]
    },
    "reliabilityGrade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E", "F", "unknown"]
    },
    "protectedRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:protected(?:-link|-request|-evidence)?|not-applicable):(?!(?:[a-z0-9._/-]*[./])?(?:bearer|token|secret|password|credential|apikey|api-key|authorization|access_token|access-token)(?:[./]|$))[a-z0-9][a-z0-9._/-]*$"
    },
    "analyticAssessment": {
      "type": "object",
      "required": [
        "likelihood",
        "analytic_confidence",
        "local_corroboration_required"
      ],
      "properties": {
        "likelihood": { "$ref": "#/$defs/likelihood" },
        "analytic_confidence": { "$ref": "#/$defs/analyticConfidence" },
        "local_corroboration_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidenceProjection": {
      "type": "object",
      "required": [
        "material_claim_id",
        "evidence_class",
        "source_id",
        "source_type",
        "provenance",
        "raw_ref",
        "normalized_value",
        "transformation",
        "transformation_version",
        "source_confidence",
        "baseline_confidence",
        "upstream_evidence_ids",
        "limitations",
        "handling_marking",
        "claim_ids",
        "behavior_bases"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "analytic_record_id": { "$ref": "#/$defs/identifier" },
        "material_claim_id": { "$ref": "#/$defs/identifier" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_type": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "raw_ref": { "type": "string", "minLength": 1 },
        "normalized_value": { "not": { "type": "null" } },
        "normalization_gap_id": { "$ref": "#/$defs/identifier" },
        "transformation": { "type": "string", "minLength": 1 },
        "transformation_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "event_time": { "$ref": "#/$defs/timestamp" },
        "ingestion_time": { "$ref": "#/$defs/timestamp" },
        "update_time": { "$ref": "#/$defs/timestamp" },
        "retrieval_time": { "$ref": "#/$defs/timestamp" },
        "source_confidence": { "$ref": "#/$defs/analyticConfidence" },
        "baseline_confidence": { "$ref": "#/$defs/analyticConfidence" },
        "upstream_evidence_ids": { "$ref": "#/$defs/idArray" },
        "source_evidence_ids": { "$ref": "#/$defs/idArray" },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "handling_marking": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/idArray" },
        "behavior_bases": { "$ref": "#/$defs/behaviorBases" }
      },
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "record_type",
        "record_id",
        "material_claim_id",
        "evidence_kind",
        "evidence_role",
        "source_id",
        "source_type",
        "retrieval_time",
        "source_confidence_ref",
        "lineage_ref",
        "support_direction",
        "is_material",
        "claim_ids",
        "analytic_assessment",
        "output_projection"
      ],
      "properties": {
        "record_type": { "const": "evidence_item" },
        "record_id": { "$ref": "#/$defs/identifier" },
        "material_claim_id": { "$ref": "#/$defs/identifier" },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "telemetry_observation",
            "provided_document",
            "analyst_note",
            "threat_intelligence_match",
            "missing_telemetry"
          ]
        },
        "evidence_role": { "$ref": "#/$defs/evidenceRole" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_type": { "type": "string", "minLength": 1 },
        "event_time": { "$ref": "#/$defs/timestamp" },
        "ingestion_time": { "$ref": "#/$defs/timestamp" },
        "update_time": { "$ref": "#/$defs/timestamp" },
        "retrieval_time": { "$ref": "#/$defs/timestamp" },
        "source_confidence_ref": { "$ref": "#/$defs/identifier" },
        "lineage_ref": { "$ref": "#/$defs/identifier" },
        "support_direction": { "$ref": "#/$defs/supportDirection" },
        "is_material": { "type": "boolean" },
        "claim_ids": { "$ref": "#/$defs/idArray" },
        "analytic_assessment": { "$ref": "#/$defs/analyticAssessment" },
        "output_projection": { "$ref": "#/$defs/evidenceProjection" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidence_kind": { "const": "missing_telemetry" } },
            "required": ["evidence_kind"]
          },
          "then": {
            "properties": {
              "evidence_role": { "const": "coverage_gap" },
              "support_direction": { "const": "gap" }
            }
          }
        },
        {
          "if": {
            "properties": { "evidence_kind": { "const": "threat_intelligence_match" } },
            "required": ["evidence_kind"]
          },
          "then": {
            "properties": {
              "evidence_role": { "const": "threat_intelligence_lead" },
              "analytic_assessment": {
                "properties": {
                  "likelihood": { "not": { "const": "highly_likely" } },
                  "local_corroboration_required": { "const": true }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "claimReferencesProjection": {
      "type": "object",
      "required": ["claim_ids", "evidence_ids", "gap_ids", "error_ids", "behavior_bases"],
      "properties": {
        "claim_ids": { "$ref": "#/$defs/idArray" },
        "evidence_ids": { "$ref": "#/$defs/idArray" },
        "gap_ids": { "$ref": "#/$defs/idArray" },
        "error_ids": { "$ref": "#/$defs/idArray" },
        "behavior_bases": { "$ref": "#/$defs/behaviorBases" }
      },
      "additionalProperties": false
    },
    "claimCitation": {
      "type": "object",
      "required": ["record_type", "claim_id", "claim_text", "material", "claim_projection"],
      "properties": {
        "record_type": { "const": "claim_citation" },
        "claim_id": { "$ref": "#/$defs/identifier" },
        "claim_text": { "type": "string", "minLength": 1 },
        "material": { "type": "boolean" },
        "claim_projection": { "$ref": "#/$defs/claimReferencesProjection" }
      },
      "allOf": [
        {
          "if": { "properties": { "material": { "const": true } }, "required": ["material"] },
          "then": { "properties": { "claim_projection": { "properties": { "evidence_ids": { "minItems": 1 } } } } }
        }
      ],
      "additionalProperties": false
    },
    "sourceConfidence": {
      "type": "object",
      "required": [
        "record_type",
        "source_confidence_id",
        "source_id",
        "reliability_grade",
        "analytic_confidence",
        "freshness",
        "source_basis",
        "reliability_rationale",
        "limitations",
        "behavior_bases"
      ],
      "properties": {
        "record_type": { "const": "source_confidence" },
        "source_confidence_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "reliability_grade": { "$ref": "#/$defs/reliabilityGrade" },
        "analytic_confidence": { "$ref": "#/$defs/analyticConfidence" },
        "freshness": { "type": "string", "enum": ["current", "stale", "unknown", "not_applicable"] },
        "source_basis": { "type": "string", "minLength": 1 },
        "reliability_rationale": { "type": "string", "minLength": 1 },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "behavior_bases": { "$ref": "#/$defs/behaviorBases" }
      },
      "additionalProperties": false
    },
    "lineageStep": {
      "type": "object",
      "required": ["step_id", "input_ref", "output_ref", "transform", "transform_version"],
      "properties": {
        "step_id": { "$ref": "#/$defs/identifier" },
        "input_ref": { "$ref": "#/$defs/protectedRef" },
        "output_ref": { "$ref": "#/$defs/protectedRef" },
        "transform": { "type": "string", "minLength": 1 },
        "transform_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "sourceLineage": {
      "type": "object",
      "required": [
        "record_type",
        "source_lineage_id",
        "evidence_id",
        "canonical_upstream_ref",
        "upstream_feed_ref",
        "relationship",
        "copy_of_evidence_id",
        "transformation_chain",
        "lineage_rationale",
        "behavior_bases"
      ],
      "properties": {
        "record_type": { "const": "source_lineage" },
        "source_lineage_id": { "$ref": "#/$defs/identifier" },
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "canonical_upstream_ref": { "type": "string", "minLength": 1 },
        "upstream_feed_ref": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "enum": ["original", "transformed_from", "copy_of", "aggregate_of"] },
        "copy_of_evidence_id": { "type": "string", "minLength": 1 },
        "transformation_chain": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lineageStep" } },
        "lineage_rationale": { "type": "string", "minLength": 1 },
        "behavior_bases": { "$ref": "#/$defs/behaviorBases" }
      },
      "additionalProperties": false
    }
  }
}
