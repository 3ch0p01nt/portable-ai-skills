{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recurrence.schema.json",
  "title": "Recurrence and Campaign Relationship Record",
  "description": "Closed Task 6 recurrence kernel record compatible with audit-output.schema.json $defs.recurrenceRecord.",
  "type": "object",
  "required": [
    "recurrence_id",
    "related_record_ref",
    "relation_basis",
    "relation_limitations",
    "claim_ids",
    "evidence_ids",
    "gap_ids",
    "error_ids",
    "behavior_bases",
    "relation_type",
    "overlap_basis",
    "relation_strength",
    "analytic_confidence",
    "confidence",
    "strong_linkage_supported",
    "temporal_plausibility",
    "prior_disposition",
    "prior_closure_quality_auditable",
    "current_disposition_inference_from_prior",
    "current_incident_protected_ref",
    "related_incident_protected_ref",
    "current_workspace_protected_ref",
    "related_workspace_protected_ref",
    "current_product",
    "related_product",
    "boundary_crossed",
    "workspace_product_boundary_crossed",
    "hidden_related_alerts_surfaced",
    "suppression_or_tuning_refs",
    "overlap_observations"
  ],
  "properties": {
    "recurrence_id": {"$ref": "#/$defs/identifier"},
    "related_record_ref": {"$ref": "#/$defs/identifier"},
    "relation_basis": {"type": "string", "minLength": 1},
    "relation_limitations": {"$ref": "#/$defs/stringArray"},
    "claim_ids": {"$ref": "#/$defs/idArray"},
    "evidence_ids": {"$ref": "#/$defs/idArray"},
    "gap_ids": {"$ref": "#/$defs/idArray"},
    "error_ids": {"$ref": "#/$defs/idArray"},
    "behavior_bases": {"$ref": "#/$defs/behaviorBases"},
    "relation_type": {"$ref": "#/$defs/relationType"},
    "overlap_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/overlapBasis"}},
    "relation_strength": {"$ref": "#/$defs/relationStrength"},
    "analytic_confidence": {"$ref": "#/$defs/analyticConfidence"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "strong_linkage_supported": {"type": "boolean"},
    "temporal_plausibility": {"$ref": "#/$defs/temporalPlausibility"},
    "prior_disposition": {"$ref": "#/$defs/priorDisposition"},
    "prior_closure_quality_auditable": {"type": "boolean"},
    "prior_closure_quality": {"$ref": "#/$defs/closureQuality"},
    "current_disposition_inference_from_prior": {"enum": ["not_supported", "not_assessed"]},
    "current_incident_protected_ref": {"$ref": "#/$defs/protectedReference"},
    "related_incident_protected_ref": {"$ref": "#/$defs/protectedReference"},
    "current_workspace_protected_ref": {"$ref": "#/$defs/protectedReference"},
    "related_workspace_protected_ref": {"$ref": "#/$defs/protectedReference"},
    "current_product": {"$ref": "#/$defs/productBoundary"},
    "related_product": {"$ref": "#/$defs/productBoundary"},
    "boundary_crossed": {"type": "boolean"},
    "workspace_product_boundary_crossed": {"type": "boolean"},
    "hidden_related_alerts_surfaced": {"type": "boolean"},
    "suppression_or_tuning_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/protectedReference"}},
    "overlap_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/overlapObservation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "behaviorBases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["guaranteed_behavior", "configurable_project_policy", "conditional_capability", "explicit_gap"]}},
    "protectedReference": {"type": "string", "minLength": 1, "pattern": "^(?:protected(?:-link|-request|-evidence)?|not-applicable):(?!(?:[a-z0-9._/-]*[./])?(?:bearer|token|secret|password|credential|apikey|api-key|authorization|access_token|access-token)(?:[./]|$))[a-z0-9][a-z0-9._/-]*$"},
    "relationType": {"enum": ["duplicate", "related", "recurrence", "campaign", "split-incident", "merged", "suppressed", "reopened"]},
    "overlapBasis": {"enum": ["entity", "infrastructure", "TTP", "causal", "detection_rule", "time", "no_overlap_observed"]},
    "relationStrength": {"enum": ["weak", "moderate", "strong"]},
    "analyticConfidence": {"enum": ["low", "moderate", "high", "not_assessed"]},
    "temporalPlausibility": {"enum": ["implausible", "unknown", "plausible", "overlapping", "ordered"]},
    "identifierStrength": {"enum": ["weak", "strong"]},
    "sharedInfrastructureContext": {"enum": ["none", "cdn", "shared-hosting", "nat", "proxy", "cloud-provider"]},
    "closureQuality": {"enum": ["supported", "insufficient_evidence", "auditable_gap", "not_assessed"]},
    "productBoundary": {"enum": ["sentinel", "defender_xdr", "other_commercial_microsoft", "unknown"]},
    "priorDisposition": {
      "type": "object",
      "required": ["classification", "determination", "closure_quality", "protected_decision_ref"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "determination": {"type": "string", "minLength": 1},
        "closure_quality": {"$ref": "#/$defs/closureQuality"},
        "protected_decision_ref": {"$ref": "#/$defs/protectedReference"}
      },
      "additionalProperties": false
    },
    "overlapObservation": {
      "type": "object",
      "required": ["basis", "identifier_strength", "identifier_ref", "temporal_plausibility", "shared_infrastructure_context", "summary", "downgraded"],
      "properties": {
        "basis": {"$ref": "#/$defs/overlapBasis"},
        "identifier_strength": {"$ref": "#/$defs/identifierStrength"},
        "identifier_ref": {"$ref": "#/$defs/protectedReference"},
        "temporal_plausibility": {"$ref": "#/$defs/temporalPlausibility"},
        "shared_infrastructure_context": {"$ref": "#/$defs/sharedInfrastructureContext"},
        "summary": {"type": "string", "minLength": 1},
        "downgraded": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
